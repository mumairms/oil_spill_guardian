# ==============================================================================
# Oil Spill Guardian - Environment Configuration & API Keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AIS STREAM (Real-time Live Vessel Tracking)
# ------------------------------------------------------------------------------
# Get your FREE API key at: https://aisstream.io/
# Used to connect to the global live AIS WebSocket stream for ship positions.
AISSTREAM_API_KEY=your_aisstream_api_key_here
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# ------------------------------------------------------------------------------
# 2. COPERNICUS DATA SPACE ECOSYSTEM (CDSE - Sentinel-1 SAR Imagery)
# ------------------------------------------------------------------------------
# Free registration at: https://dataspace.copernicus.eu/
# Go to User Settings -> API Keys / OAuth2 Client Credentials
# Note: Basic catalog search works even without keys; keys are needed for high-speed download & S3 (12 TB/month free)
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac/search

# ------------------------------------------------------------------------------
# 3. MARINE WEATHER & OCEAN CURRENTS (Open-Meteo & CMEMS)
# ------------------------------------------------------------------------------
# Open-Meteo is 100% FREE and requires NO API KEY (up to 10,000 req/day).
# Aggregates NOAA GFS Marine & Copernicus ocean physics models.
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 4. DATABASE & QUEUE SETTINGS
# ------------------------------------------------------------------------------
# Default SQLite for instant local dev (or Postgres+PostGIS: postgresql://user:pass@localhost:5432/oilspill)
DATABASE_URL=sqlite:///./oilspill.db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. CORRELATION ENGINE PARAMETERS
# ------------------------------------------------------------------------------
CORRELATION_RADIUS_KM=15
CORRELATION_LOOKBACK_HOURS=12
