# ==============================================================================
# Oil Spill Guardian - Environment Configuration & API Keys
# ==============================================================================

# 1. AISSTREAM (Live AIS Ship Tracking) - Free key at https://aisstream.io/
AISSTREAM_API_KEY=

# 2. COPERNICUS CDSE (Sentinel-1 SAR) - Free at https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 3. OPEN-METEO (Weather & Ocean Currents) - No key needed!
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# 4. DATABASE & REDIS
DATABASE_URL=sqlite:///./oilspill.db
REDIS_URL=redis://localhost:6379/0

# 5. ENGINE PARAMETERS
CORRELATION_RADIUS_KM=15
CORRELATION_LOOKBACK_HOURS=12
